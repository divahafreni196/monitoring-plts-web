# ============================================================
# Konfigurasi Firebase untuk PLTS Monitoring Dashboard (React)
# ============================================================
# Cara menggunakan:
# 1. Salin file ini menjadi .env
# 2. Isi nilai dari Firebase Console:
#    Firebase Console -> Project Settings -> General
#    -> Your apps -> Web app -> SDK setup and configuration
# 3. Vite akan otomatis membaca .env saat dev/build
# ============================================================

VITE_FIREBASE_API_KEY=ISI_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=ISI_AUTH_DOMAIN
VITE_FIREBASE_DATABASE_URL=https://monitoring-plts-dipa-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=ISI_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=ISI_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=ISI_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=ISI_APP_ID

# Token bot Telegram dari @BotFather (untuk notifikasi abnormal).
# CATATAN: pada pendekatan tanpa backend, token terbaca publik di bundle browser.
VITE_TELEGRAM_BOT_TOKEN=ISI_TELEGRAM_BOT_TOKEN
